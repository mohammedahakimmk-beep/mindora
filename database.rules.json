{
  "rules": {
    "config": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'mohammed.ahakim.mk@gmail.com'"
    },
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true || auth.token.email == 'mohammed.ahakim.mk@gmail.com')",
        ".write": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true || auth.token.email == 'mohammed.ahakim.mk@gmail.com')"
      }
    },
    "admins": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() == true || auth.token.email == 'mohammed.ahakim.mk@gmail.com')",
      ".write": "auth != null && auth.token.email == 'mohammed.ahakim.mk@gmail.com'",
      "$uid": {
        ".validate": "newData.isBoolean() || newData.hasChildren(['email','role'])"
      }
    },
    "energy": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || auth.token.email == 'mohammed.ahakim.mk@gmail.com')",
        ".write": "auth != null && (auth.uid == $uid || auth.token.email == 'mohammed.ahakim.mk@gmail.com')"
      }
    },
    "progress": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || auth.token.email == 'mohammed.ahakim.mk@gmail.com')",
        ".write": "auth != null && (auth.uid == $uid || auth.token.email == 'mohammed.ahakim.mk@gmail.com')"
      }
    },
    "analytics": {
      ".read": "auth != null && auth.token.email == 'mohammed.ahakim.mk@gmail.com'",
      ".write": "auth != null"
    }
  }
}
