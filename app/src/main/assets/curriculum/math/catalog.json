  "lessons": [
    {
      "id": "numbers_lesson_1",
      "topicId": "numbers_basics",
      "title": "Understanding Numbers",
      "description": "Learn place value and how numbers are structured.",
      "videoUrl": "https://storage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4",
      "videoTitle": "Place Value Explained",
      "stages": [
        {
          "id": "nb_s1",
          "type": "CONTENT",
          "title": "What Are Numbers?",
          "content": "Numbers help us count, measure, and compare. Each digit in a number has a place value based on its position.\n\nIn 3,482:\n• 3 is in the thousands place (3,000)\n• 4 is in the hundreds place (400)\n• 8 is in the tens place (80)\n• 2 is in the ones place (2)\n\nSo 3,482 = 3,000 + 400 + 80 + 2"
        },
        {
          "id": "nb_s2",
          "type": "VIDEO",
          "title": "Video: Place Value",
          "content": "Watch this lesson on how place value works.",
          "videoUrl": "https://storage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4"
        },
        {
          "id": "nb_s3",
          "type": "EXAMPLE",
          "title": "Worked Example",
          "content": "Let's break down the number 5,607.",
          "examples": [
            {
              "problem": "What is the value of each digit in 5,607?",
              "solution": "5,607 = 5,000 + 600 + 0 + 7",
              "steps": [
                "5 is in the thousands place → 5,000",
                "6 is in the hundreds place → 600",
                "0 is in the tens place → 0",
                "7 is in the ones place → 7"
              ]
            }
          ]
        },
        {
          "id": "nb_s4",
          "type": "PRACTICE",
          "title": "Practice",
          "questions": [
            {
              "id": "nb_q1",
              "type": "NUMERIC",
              "prompt": "What is the value of the digit 7 in 2,739?",
              "correctAnswer": "700",
              "explanation": "The 7 is in the hundreds place, so its value is 700.",
              "hint": "Look at which place the 7 occupies — hundreds, tens, or ones?",
              "difficulty": 1
            },
            {
              "id": "nb_q2",
              "type": "MULTIPLE_CHOICE",
              "prompt": "Which number has 4 in the tens place?",
              "options": ["1,456", "4,561", "1,465", "1,546"],
              "correctAnswer": "1,465",
              "explanation": "In 1,465, the 4 is in the tens place (40).",
              "hint": "The tens digit is the second digit from the right.",
              "difficulty": 1
            }
          ]
        },
        {
          "id": "nb_s5",
          "type": "QUIZ",
          "title": "Quick Check",
          "questions": [
            {
              "id": "nb_q3",
              "type": "NUMERIC",
              "prompt": "Write 3 thousands, 2 hundreds, 5 tens, and 1 one as a number.",
              "correctAnswer": "3251",
              "explanation": "3,000 + 200 + 50 + 1 = 3,251",
              "hint": "Add each place value together.",
              "difficulty": 2
            },
            {
              "id": "nb_q4",
              "type": "TRUE_FALSE",
              "prompt": "In the number 8,904, the 0 is in the hundreds place.",
              "options": ["True", "False"],
              "correctAnswer": "false",
              "explanation": "The 0 is in the tens place. The 9 is in the hundreds place.",
              "hint": "Count places from right to left: ones, tens, hundreds...",
              "difficulty": 1
            }
          ]
        }
      ]
    },
    {
      "id": "add_sub_lesson_1",
      "topicId": "addition_subtraction",
      "title": "Adding & Subtracting",
      "description": "Build fluency with addition and subtraction.",
      "videoUrl": "https://storage.googleapis.com/gtv-videos-bucket/sample/ElephantsDream.mp4",
      "videoTitle": "Addition Strategies",
      "stages": [
        {
          "id": "as_s1",
          "type": "CONTENT",
          "title": "Addition & Subtraction",
          "content": "Addition combines quantities (+). Subtraction finds the difference (−).\n\nKey strategies:\n• Count on for small numbers\n• Use number bonds to make 10\n• Regroup (carry/borrow) for larger numbers\n\nExample: 47 + 28\n• 7 + 8 = 15 (write 5, carry 1)\n• 4 + 2 + 1 = 7\n• Answer: 75"
        },
        {
          "id": "as_s2",
          "type": "VIDEO",
          "title": "Video: Addition with Regrouping",
          "content": "Learn the regrouping technique.",
          "videoUrl": "https://storage.googleapis.com/gtv-videos-bucket/sample/ElephantsDream.mp4"
        },
        {
          "id": "as_s3",
          "type": "EXAMPLE",
          "title": "Worked Example",
          "examples": [
            {
              "problem": "Calculate 83 − 47",
              "solution": "83 − 47 = 36",
              "steps": [
                "Can't subtract 7 from 3, so borrow from tens",
                "13 − 7 = 6",
                "7 − 4 = 3 (after borrowing, 7 tens remain)",
                "Answer: 36"
              ]
            }
          ]
        },
        {
          "id": "as_s4",
          "type": "PRACTICE",
          "title": "Practice",
          "questions": [
            {
              "id": "as_q1",
              "type": "NUMERIC",
              "prompt": "What is 56 + 37?",
              "correctAnswer": "93",
              "explanation": "56 + 37 = 93. Add ones: 6+7=13, carry 1. Add tens: 5+3+1=9.",
              "hint": "Add the ones first, then the tens.",
              "difficulty": 1
            },
            {
              "id": "as_q2",
              "type": "NUMERIC",
              "prompt": "What is 92 − 45?",
              "correctAnswer": "47",
              "explanation": "92 − 45 = 47. Borrow from tens to subtract 5 from 2.",
              "hint": "You may need to regroup from the tens place.",
              "difficulty": 2
            }
          ]
        },
        {
          "id": "as_s5",
          "type": "QUIZ",
          "title": "Quick Check",
          "questions": [
            {
              "id": "as_q3",
              "type": "NUMERIC",
              "prompt": "A forge has 128 stars. 53 are forged. How many remain?",
              "correctAnswer": "75",
              "explanation": "128 − 53 = 75 stars remain.",
              "hint": "This is a subtraction word problem.",
              "difficulty": 2
            },
            {
              "id": "as_q4",
              "type": "MULTIPLE_CHOICE",
              "prompt": "Which expression equals 100?",
              "options": ["45 + 55", "60 + 30", "70 + 20", "35 + 55"],
              "correctAnswer": "45 + 55",
              "explanation": "45 + 55 = 100.",
              "hint": "Add each pair and find which sums to 100.",
              "difficulty": 1
            }
          ]
        }
      ]
    },
    {
      "id": "mult_div_lesson_1",
      "topicId": "multiplication_division",
      "title": "Multiply & Divide",
      "description": "Master multiplication and division operations.",
      "videoUrl": "https://storage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4",
      "videoTitle": "Multiplication Fundamentals",
      "stages": [
        {
          "id": "md_s1",
          "type": "CONTENT",
          "title": "Multiplication & Division",
          "content": "Multiplication is repeated addition: 4 × 3 = 3 + 3 + 3 + 3 = 12\n\nDivision splits into equal groups: 12 ÷ 4 = 3\n\nKey facts:\n• Any number × 0 = 0\n• Any number × 1 = itself\n• Division by 0 is undefined\n\nLong multiplication: 23 × 4 = (20 × 4) + (3 × 4) = 80 + 12 = 92"
        },
        {
          "id": "md_s2",
          "type": "VIDEO",
          "title": "Video: Times Tables",
          "content": "Memorize and apply multiplication facts.",
          "videoUrl": "https://storage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4"
        },
        {
          "id": "md_s3",
          "type": "EXAMPLE",
          "title": "Worked Example",
          "examples": [
            {
              "problem": "Calculate 48 ÷ 6",
              "solution": "48 ÷ 6 = 8",
              "steps": [
                "Think: what times 6 equals 48?",
                "6 × 8 = 48",
                "Answer: 8"
              ]
            }
          ]
        },
        {
          "id": "md_s4",
          "type": "PRACTICE",
          "title": "Practice",
          "questions": [
            {
              "id": "md_q1",
              "type": "NUMERIC",
              "prompt": "What is 7 × 8?",
              "correctAnswer": "56",
              "explanation": "7 × 8 = 56. This is a key times table fact.",
              "hint": "7 × 8 = 7 × (10 − 2) = 70 − 14 = 56",
              "difficulty": 1
            },
            {
              "id": "md_q2",
              "type": "NUMERIC",
              "prompt": "What is 72 ÷ 9?",
              "correctAnswer": "8",
              "explanation": "72 ÷ 9 = 8 because 9 × 8 = 72.",
              "hint": "Use your 9 times table.",
              "difficulty": 1
            }
          ]
        },
        {
          "id": "md_s5",
          "type": "QUIZ",
          "title": "Quick Check",
          "questions": [
            {
              "id": "md_q3",
              "type": "NUMERIC",
              "prompt": "What is 15 × 6?",
              "correctAnswer": "90",
              "explanation": "15 × 6 = (10 × 6) + (5 × 6) = 60 + 30 = 90.",
              "hint": "Break 15 into 10 + 5.",
              "difficulty": 2
            },
            {
              "id": "md_q4",
              "type": "MULTIPLE_CHOICE",
              "prompt": "Which is the same as 56 ÷ 8?",
              "options": ["7", "6", "8", "9"],
              "correctAnswer": "7",
              "explanation": "56 ÷ 8 = 7.",
              "hint": "8 × ? = 56",
              "difficulty": 1
            }
          ]
        }
      ]
    },
    {
      "id": "fractions_lesson_1",
      "topicId": "fractions",
      "title": "Working with Fractions",
      "description": "Understand and operate on fractions.",
      "videoUrl": "https://storage.googleapis.com/gtv-videos-bucket/sample/ForBiggerEscapes.mp4",
      "videoTitle": "Fraction Fundamentals",
      "stages": [
        {
          "id": "fr_s1",
          "type": "CONTENT",
          "title": "Fraction Basics",
          "content": "A fraction represents parts of a whole: numerator/denominator\n\n• 3/4 means 3 parts out of 4 equal parts\n• Equivalent fractions: 1/2 = 2/4 = 3/6\n• To add fractions: find common denominator\n\nExample: 1/4 + 2/4 = 3/4\nExample: 1/2 + 1/3 = 3/6 + 2/6 = 5/6"
        },
        {
          "id": "fr_s2",
          "type": "VIDEO",
          "title": "Video: Adding Fractions",
          "content": "Learn to add fractions with different denominators.",
          "videoUrl": "https://storage.googleapis.com/gtv-videos-bucket/sample/ForBiggerEscapes.mp4"
        },
        {
          "id": "fr_s3",
          "type": "EXAMPLE",
          "title": "Worked Example",
          "examples": [
            {
              "problem": "Simplify 6/8",
              "solution": "6/8 = 3/4",
              "steps": [
                "Find the GCD of 6 and 8, which is 2",
                "Divide both numerator and denominator by 2",
                "6÷2 = 3, 8÷2 = 4",
                "Answer: 3/4"
              ]
            }
          ]
        },
        {
          "id": "fr_s4",
          "type": "PRACTICE",
          "title": "Practice",
          "questions": [
            {
              "id": "fr_q1",
              "type": "MULTIPLE_CHOICE",
              "prompt": "Which fraction is equivalent to 1/2?",
              "options": ["2/4", "1/3", "3/5", "2/3"],
              "correctAnswer": "2/4",
              "explanation": "2/4 = 1/2 when simplified (divide both by 2).",
              "hint": "Multiply or divide top and bottom by the same number.",
              "difficulty": 1
            },
            {
              "id": "fr_q2",
              "type": "MULTIPLE_CHOICE",
              "prompt": "What is 1/3 + 1/3?",
              "options": ["2/3", "2/6", "1/6", "2/9"],
              "correctAnswer": "2/3",
              "explanation": "When denominators are the same, add numerators: 1+1=2, keep denominator 3.",
              "hint": "Same denominator? Just add the tops.",
              "difficulty": 1
            }
          ]
        },
        {
          "id": "fr_s5",
          "type": "QUIZ",
          "title": "Quick Check",
          "questions": [
            {
              "id": "fr_q3",
              "type": "MULTIPLE_CHOICE",
              "prompt": "What is 2/5 + 1/5?",
              "options": ["3/5", "3/10", "1/5", "2/5"],
              "correctAnswer": "3/5",
              "explanation": "2/5 + 1/5 = 3/5.",
              "hint": "Add numerators when denominators match.",
              "difficulty": 1
            },
            {
              "id": "fr_q4",
              "type": "TRUE_FALSE",
              "prompt": "3/4 is greater than 2/3.",
              "options": ["True", "False"],
              "correctAnswer": "true",
              "explanation": "3/4 = 0.75 and 2/3 ≈ 0.67, so 3/4 is greater.",
              "hint": "Convert to decimals or find a common denominator.",
              "difficulty": 2
            }
          ]
        }
      ]
    },
