<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Mindora" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/night_sky</item>
        <item name="android:navigationBarColor">@color/night_sky</item>
        <item name="android:windowBackground">@color/night_sky</item>
    </style>
    <!-- Use vector drawable (not adaptive mipmap) to avoid splash-screen crashes -->
    <style name="Theme.Mindora.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/night_sky</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Mindora</item>
    </style>
</resources>
